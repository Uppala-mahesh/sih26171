{
  "version": "1.0.0",
  "note": "Cross-runtime parity corpus for pixel redaction and the egress guard. Frame bytes are GENERATED by an algorithm spelled out below rather than stored, so both runtimes build identical buffers from integer arithmetic and nothing depends on a base64 blob somebody pasted. The out-of-bounds frame exists because in-bounds boxes make IoU trivially 1.0 and the geometry check stops discriminating.",
  "background": [200, 200, 200],
  "ink": [30, 30, 30],
  "ink_rule": "pixel is ink when ((x*7 + y*13 + boxIndex*29) % 5) != 0",
  "frames": [
    {
      "name": "two-in-bounds",
      "width": 24,
      "height": 16,
      "channels": 3,
      "boxes": [[2, 2, 6, 4], [10, 3, 8, 6]],
      "entities": ["AADHAAR", "EMAIL"]
    },
    {
      "name": "out-of-bounds",
      "width": 24,
      "height": 16,
      "channels": 3,
      "boxes": [[18, 12, 20, 12]],
      "entities": ["PAN"]
    },
    {
      "name": "no-boxes",
      "width": 12,
      "height": 10,
      "channels": 3,
      "boxes": [],
      "entities": []
    },
    {
      "name": "grayscale-single-channel",
      "width": 14,
      "height": 14,
      "channels": 1,
      "boxes": [[1, 1, 8, 8]],
      "entities": ["DOB"]
    }
  ],
  "guard_cases": [
    {
      "name": "clean-sanitized",
      "state": "SANITIZED",
      "frameBlind": false,
      "title": "Account overview",
      "safeTexts": ["Balance updated"],
      "elements": [
        { "ariaLabel": "Account number", "textContent": "<AADHAAR_1#deadbeef>" }
      ]
    },
    {
      "name": "forged-sanitized-carrying-raw-pii",
      "state": "SANITIZED",
      "frameBlind": false,
      "title": "Account overview",
      "safeTexts": [],
      "elements": [
        { "ariaLabel": "Contact", "textContent": "parker.sterling@example.test" }
      ]
    },
    {
      "name": "not-instrumented",
      "state": "NOT_INSTRUMENTED",
      "frameBlind": false,
      "title": "Account overview",
      "safeTexts": [],
      "elements": [{ "ariaLabel": "A", "textContent": "nothing" }]
    },
    {
      "name": "frame-blind-but-claims-sanitized",
      "state": "SANITIZED",
      "frameBlind": true,
      "title": "Account overview",
      "safeTexts": [],
      "elements": [{ "ariaLabel": "A", "textContent": "nothing" }]
    },
    {
      "name": "degraded-but-clean",
      "state": "DEGRADED",
      "frameBlind": false,
      "title": "Account overview",
      "safeTexts": ["Clean text"],
      "elements": [{ "ariaLabel": "A", "textContent": "nothing" }]
    }
  ]
}

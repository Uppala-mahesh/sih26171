# ═══════════════════════════════════════════════════════════════════════════
# SIH26171 — sih-agent-v2
# ═══════════════════════════════════════════════════════════════════════════

# ─── Secrets (charter C-2: no secret may be committed) ──────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
service-account*.json

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
build/
dist/

# ─── Node / TypeScript (console + extension tooling) ───────────────────────
node_modules/
.vite/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-error.log*

# ─── ML model weights and large binaries ───────────────────────────────────
# Model weights are large and should be fetched or tracked via Git LFS,
# never committed directly. See DES-ARCH-001 for the model acquisition plan.
*.onnx
*.pt
*.pth
*.tflite
*.traineddata
*.traineddata.gz
*.wasm
*.wasm.js

# Extension vendor bundles are generated/pruned at build time (see RETIRE list),
# not committed by hand.
apps/extension/vendor/
apps/extension/tessdata/

# ─── Benchmarks & audit output ─────────────────────────────────────────────
# Benchmark results are regenerated by a documented command (charter C-4).
# Only the generated scorecard artifact is tracked; raw runs are not.
benchmarks/results/
benchmarks/raw/
audit-output/
*.jsonl

# ─── Captured artefacts that may contain real page content ─────────────────
# Screenshots of live pages are PII-bearing by definition. Never commit them.
screenshots/
*.png
*.jpg
!docs/**/*.png
testdata/**/*.rendered.*

# ─── Browser profiles (a live Chrome profile contains Cookies, Login Data,
#     History. This class of leak already exists in v1 — do not repeat it.) ──
**/chrome-profile/
**/user-data-dir/
**/Default/Cookies
**/Default/Login Data
**/Default/History

# ─── IDE / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ─── Built Chrome artefact ───
# dist-extension/ is a reproducible output of `npm run build:extension`, never a
# source. It is gitignored because a committed build silently diverges from the
# sources, and anyone loading a stale build would be reviewing the wrong thing.
dist-extension/

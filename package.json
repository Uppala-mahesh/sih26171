{
  "name": "sih-agent-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SIH26171 - Privacy-preserving browser agent with on-device visual perception",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:extension": "tsc --noEmit -p tsconfig.extension.json",
    "generate:taxonomy": "python infra/generate_taxonomy.py",
    "check:taxonomy": "python infra/generate_taxonomy.py --check",
    "build:parity": "node infra/build-parity.cjs",
    "build:extension": "node infra/build-extension.cjs",
    "test:worker": "node tests/runtime/worker_harness.mjs",
    "diagnose:browser": "node tests/runtime/chrome_diagnose.mjs",
    "probe:load": "node tests/runtime/load_unpacked_probe.mjs",
    "verify": "npm run typecheck && npm run check:taxonomy && npm run build:parity && npm run build:extension && npm run test:worker"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "typescript": "^5.8.3"
  }
}
